{
    "name": "chili3d",
    "version": "0.8.0",
    "description": "",
    "documentVersion": "0.7.1",
    "author": "仙阁",
    "type": "module",
    "scripts": {
        "build": "rspack build && node scripts/build-plugins.mjs && node scripts/finalize-pwa.mjs",
        "build:wasm": "cd cpp && cmake --preset release && cmake --build --preset release",
        "build:types": "node scripts/generate_types.mjs",
        "check": "biome check --write",
        "check:garlic": "node scripts/check-garlic.mjs",
        "dev": "rspack dev",
        "format": "biome check --write . && npx clang-format --style=Webkit --sort-includes -i ./cpp/src/**",
        "generate:capabilities": "node scripts/generate-shape-capabilities.mjs",
        "preview": "rspack preview --port 4173",
        "release": "node scripts/release.mjs",
        "setup:wasm": "node scripts/setup_wasm_deps.mjs",
        "test": "rstest",
        "test:scenarios": "node scripts/scenario.mjs",
        "testc": "rstest --coverage"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{ts,js,css,json,mjs}": [
            "npx biome check --write --no-errors-on-unmatched"
        ],
        "*.{c,h,cxx,hxx,cpp,hpp}": [
            "npx clang-format --style=Webkit --sort-includes -i"
        ]
    },
    "workspaces": [
        "packages/*",
        "plugins/*"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@rspack/cli": "^2.3.3",
        "@rspack/core": "^2.3.3",
        "@rspack/dev-server": "^2.2.2",
        "@rstest/core": "^0.12.6",
        "@rstest/coverage-istanbul": "^0.12.6",
        "clang-format": "^1.8.0",
        "happy-dom": "^20.9.0",
        "lint-staged": "^17.6.1",
        "simple-git-hooks": "2.14.0",
        "ts-checker-rspack-plugin": "^1.8.0",
        "typescript": "^7.0.2",
        "typescript-plugin-css-modules": "^5.3.0"
    },
    "dependencies": {
        "@types/jszip": "^3.4.1",
        "jszip": "^3.10.2"
    }
}
